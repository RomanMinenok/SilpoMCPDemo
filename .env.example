# Required on Vercel. Created automatically by the Upstash Marketplace integration.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Required whenever Redis is configured. Use at least 32 random characters.
SESSION_SECRET=

# Recommended for Production. Do not add a trailing slash.
APP_ORIGIN=https://your-project.vercel.app

# Optional override.
SILPO_MCP_URL=https://mcp.silpo.ua/mcp

# Optional. Enables the on-demand comic commentary for the top products.
# Keep the real value only in a local .env file or the Vercel environment settings.
OPENROUTER_API_KEY=
